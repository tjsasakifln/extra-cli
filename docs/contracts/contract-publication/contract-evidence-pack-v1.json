{
  "schema": "contract-evidence-pack/1.0",
  "accepted_schemas": ["contract-evidence-pack/1.0", "contract_evidence_pack/1.0"],
  "contract_version": "v1.0.0",
  "accepted_versions": ["1.0", "v1.0.0", "1.0.0"],
  "compatibility": "additive_nullable_within_v1",
  "grain": "canonical_contract_id",
  "epistemic_classes": ["FACT", "CALCULATION", "INFERENCE", "UNKNOWN"],
  "required_when_applicable": [
    "canonical_contract_ids",
    "process_ids",
    "organ",
    "contractor",
    "object",
    "location",
    "values",
    "dates",
    "timeline",
    "terms",
    "amendments",
    "apostilles",
    "documents",
    "source_urls",
    "raw_refs",
    "facts",
    "calculations",
    "inferences",
    "unknowns",
    "peer_group",
    "score",
    "reason_codes",
    "policy_version",
    "as_of",
    "coverage",
    "freshness",
    "missingness",
    "limitations",
    "sensitivity_flags",
    "content_hash",
    "schema",
    "producer_sha"
  ],
  "forbidden_pack_fields": [
    "seo_title",
    "cta",
    "index",
    "noindex",
    "INDEX",
    "PUBLISHABLE_INDEX",
    "PUBLISHABLE_NOINDEX",
    "has_right",
    "imbalance",
    "loss",
    "should_adjust",
    "irregular",
    "fraude"
  ],
  "privacy": {
    "cpf_export_mask": "CPF:***.***.***-**",
    "strip": ["email", "phone", "rg", "home_address"]
  },
  "hash": {
    "algorithm": "sha256",
    "canonical_json": "sort_keys, separators=(',', ':'), ensure_ascii=false",
    "excludes": ["content_hash"]
  }
}
