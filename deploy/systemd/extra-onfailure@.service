# /etc/systemd/system/extra-onfailure@.service
# Template unit for failure notifications via webhook
# Extra Consultoria — Story FEAT-4.1
#
# Usage: referenced by OnFailure=extra-onfailure@%n.service in other units
# Optional: WEBHOOK_URL in /opt/extra-consultoria/.env. The durable host-local
# ledger is authoritative; remote delivery is best-effort and cannot cascade.

[Unit]
Description=Extra Consultoria — OnFailure alert for %i

[Service]
Type=oneshot
User=extra-consultoria
Group=extra-consultoria
EnvironmentFile=-/opt/extra-consultoria/.env
Environment=ALERT_ONFAILURE_LEDGER=/var/lib/extra-consultoria/alerts/onfailure.jsonl
ExecStart=/opt/extra-consultoria/.venv/bin/python /opt/extra-consultoria/scripts/ops/onfailure_alert.py --service %i --host %H
