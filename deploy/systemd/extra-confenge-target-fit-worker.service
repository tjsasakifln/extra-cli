[Unit]
Description=Extra Consultoria — CONFENGE target-fit worker (long-running)
Documentation=file:/opt/extra-cli/docs/confenge/TARGET-FIT-CONTINUOUS-REFRESH.md
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=extra
WorkingDirectory=/opt/extra-cli
EnvironmentFile=-/etc/extra-cli/extra-collector.env
Environment=TARGET_FIT_ASYNC_MODE=SHADOW
Environment=TARGET_FIT_BATCH_SIZE=50
Environment=TARGET_FIT_LOCK_TTL_SECONDS=300
ExecStart=/usr/bin/python3 -m scripts.confenge_target_fit worker --loop --idle-sleep 20
Restart=on-failure
RestartSec=45
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=6
# Graceful stop: worker catches KeyboardInterrupt / SIGTERM via python default → exit
KillSignal=SIGINT
TimeoutStopSec=60
# Conservative memory ceiling so worker cannot starve PNCP / Postgres
MemoryMax=512M
MemoryHigh=384M

[Install]
WantedBy=multi-user.target
