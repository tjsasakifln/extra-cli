CONFENGE_CONTACT_BACKEND_CONCURRENCY=12
CONFENGE_CONTACT_DOMAIN_CONCURRENCY=1
CONFENGE_CONTACT_POLL_SECONDS=30
CONFENGE_CONTACT_TIMEOUT_HOURS=18
