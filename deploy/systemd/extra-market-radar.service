[Unit]
Description=Extra Consultoria — sanitized PNCP Market Radar projection
Documentation=file:/opt/confenge-market-radar-producer/current/docs/contracts/market-radar-v1.md
After=postgresql.service
Wants=postgresql.service
# Independent read consumer of the persisted datalake. Never couple this unit
# to pncp-contracts.service with OnSuccess, Requires or BindsTo.

[Service]
Type=oneshot
User=confenge-radar
Group=confenge-radar
WorkingDirectory=/opt/confenge-market-radar-producer/current
Environment=PYTHONPATH=/opt/confenge-market-radar-producer/current
ExecStart=/opt/extra-consultoria/.venv/bin/python /opt/confenge-market-radar-producer/current/scripts/public_exports/market_radar.py \
    --output-dir /var/lib/confenge-market-radar
UMask=0027
Nice=10
CPUQuota=150%
MemoryMax=2G
IOSchedulingClass=idle
TimeoutStartSec=45m
NoNewPrivileges=true
RestrictAddressFamilies=AF_UNIX
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/confenge-market-radar
StandardOutput=journal
StandardError=journal
SyslogIdentifier=extra-market-radar

[Install]
WantedBy=multi-user.target
