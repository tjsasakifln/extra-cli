[Unit]
Description=Timer — rebuild durable CONFENGE commercial authority from the datalake

[Timer]
# Independent commercial cadence. PNCP ingestion health never controls this
# timer; the service reads the persisted canonical V2 view under its own flock.
OnCalendar=*-*-* 02,08,14,20:15:00
Persistent=true
RandomizedDelaySec=10m
Unit=extra-confenge-feed-cycle.service

[Install]
WantedBy=timers.target
