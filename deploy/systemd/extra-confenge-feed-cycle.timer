[Unit]
Description=Timer — publish the CONFENGE outreach feed on an independent commercial cadence

[Timer]
# Independent commercial cadence.  PNCP ingestion health never controls this
# timer: the feed cycle reads the persisted datalake under its own flock, so a
# STALE/UNKNOWN source degrades telemetry, not publication.
OnCalendar=*-*-* 02,08,14,20:15:00
Persistent=true
RandomizedDelaySec=10m
Unit=extra-confenge-feed-cycle.service

[Install]
WantedBy=timers.target
